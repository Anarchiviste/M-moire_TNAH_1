@book{bermes_lecran_2024,
	address = {Paris},
	title = {De l'écran à l'émotion: quand le numérique devient patrimoine},
	isbn = {978-2-35723-187-0},
	shorttitle = {De l'écran à l'émotion},
	abstract = {Depuis plus de trente ans, documents et données numériques irriguent la société et engendrent de profondes transformations économiques, sociales et culturelles. En faisant leur entrée dans les collections des bibliothèques, archives et musées, ces nouveaux objets suscitent la question de l'émergence d'un patrimoine numérique. À travers une approche transdisciplinaire mêlant histoire des institutions patrimoniales, sciences de l'information, mais aussi des éléments de sociologie et d'anthropologie, Emmanuelle Bermès retrace le processus de patrimonialisation des collections numériques et s'interroge sur les engouements, les controverses et les initiatives qu'elles suscitent. À l'heure de la mise en données du monde et de l'intelligence artificielle, la connaissance de notre patrimoine numérique et de son histoire est une clef pour comprendre la culture numérique dans laquelle nous sommes désormais immergés. Quelle place les émotions tiennent-elles dans un univers régi par les écrans, les réseaux, les algorithmes ? Qu'avons-nous reçu en héritage, et que transmettrons-nous aux générations futures ? Autant de questions qui ne peuvent plus se permettre d'ignorer le numérique, en tant que paradigme majeur de notre relation à la société et aux traces qu'elle élabore et pérennise à travers le temps},
	language = {fre},
	publisher = {École nationale des chartes-PSL},
	author = {Bermès, Emmanuelle},
	year = {2024},
	keywords = {A lire, lecture},
}

